# PostgreSQL Backup Configuration - Defaults
# Override these in .development.env for local settings

# === DATABASE SETTINGS ===
DB_USER="nicolaivinther"
DB_LIST="pinnacle_odds,basketball_stats,icehockey_stats,multisport_stats"

# === LOCAL SETTINGS ===
# NOT /tmp: macOS wipes /tmp on reboot, which silently destroyed the log trail
# for the three backups missed between 2026-07-10 and 2026-07-26.
BACKUP_DIR="/Users/nicolaitanghoj/pg_backups"

# === REMOTE SERVER (Marcus) ===
# Marcus renamed the disk from "Cloud" to "Z" in Aug 2026 (capital Z — his
# message said "z", but Linux paths are case-sensitive and the mount is "Z").
REMOTE_PATH="/media/antimac/Z/pg_backups"

# === RETENTION ===
# Local stays at 1: a full set is ~20GB and the boot volume has ~104GB free.
KEEP_LOCAL_BACKUPS="1"
# Remote is 12 (~3 months of weekly runs, ~242GB of the 938GB dedicated disk).
# Retention has to exceed how long a failure can go unnoticed — the 2026-07
# outage went 3 weeks undetected, which would have outlived a retention of 2.
KEEP_REMOTE_BACKUPS="12"

# === ALERTING ===
# Sentry DSN (same project as heartbeat_server). Write-only ingestion key.
# Leave empty to disable alerting; the backup itself still runs.
SENTRY_DSN="https://5268b1ca9669e3167a34af3a8cffad33@o4510018430369792.ingest.de.sentry.io/4510018433712208"
SENTRY_ENVIRONMENT="production"
