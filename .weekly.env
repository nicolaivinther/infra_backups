# Profile: weekly — the large, slow-changing archive database.
#
# Invoked as: ./local_cronjobs/backup_postgres.sh weekly
#
# pinnacle_odds is ~17.8GB compressed and takes ~35 min to dump plus ~70 min to
# push over the tunnel, so weekly is the right cadence. The small operational
# databases are handled nightly — see .daily.env.

DB_LIST="pinnacle_odds"

# 12 weekly copies = ~3 months, ~214GB remote. Deliberately NOT reduced: disk is
# not the constraint (285GB total across both profiles, of 938GB), and this is
# both the database that is hardest to lose and the slowest to rebuild.
KEEP_REMOTE_BACKUPS="12"

# 0 = dump, ship to Marcus, verify remote, then delete the local copy. The
# ~18GB dump only lives locally for the duration of the run, so peak local
# usage is one copy instead of two. Trade-off: restoring pinnacle_odds always
# means pulling it back from Marcus first. Deletion still only happens after
# the remote copy is size-verified — a failed run leaves the local dump behind.
KEEP_LOCAL_BACKUPS="0"

# Peak local usage is the one in-flight dump (~18GB) plus margin.
MIN_FREE_GB="25"
