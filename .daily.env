# Profile: daily — the small, fast-changing operational databases.
#
# Invoked as: ./local_cronjobs/backup_postgres.sh daily
#
# The data is lopsided: these three total ~2.4GB while pinnacle_odds alone is
# ~17.8GB. Dumping the small ones nightly costs ~2.4GB over the tunnel (~10 min)
# and drops worst-case data loss on the fast-moving data from 7 days to 1.
# pinnacle_odds stays weekly — see .weekly.env.

DB_LIST="basketball_stats,icehockey_stats,multisport_stats"

# 30 nightly copies = one month of daily recovery points, ~71GB remote.
KEEP_REMOTE_BACKUPS="30"
KEEP_LOCAL_BACKUPS="1"

# Peak local usage is two sets of ~2.4GB, so the 45GB floor for the weekly
# profile is irrelevant here.
MIN_FREE_GB="10"
